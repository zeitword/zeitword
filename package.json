{
  "name": "zeitword",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "api-key:create": "node --env-file-if-exists=.env --import tsx scripts/create-site-api-key.ts",
    "s3:update-cors": "node --env-file-if-exists=.env --import tsx scripts/update-s3-cors.ts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "test": "vitest run",
    "test:e2e": "node tests/e2e/dependency-upgrade.mjs",
    "test:e2e:auth": "node --import tsx tests/e2e/auth.mjs",
    "test:e2e:mcp": "node tests/e2e/mcp.mjs"
  },
  "dependencies": {
