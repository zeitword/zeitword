    "iso-639-1": "^3.1.6",
    "lexorank": "^1.0.5",
    "lodash-es": "^4.18.1",
    "nanoid": "^6.0.2",
    "nuxt": "^4.6.2",
    "pg": "^8.23.1",
    "reka-ui": "^2.11.0",
    "resend": "^6.34.1",
    "sortablejs": "^1.15.7",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "uuidv7": "^1.2.1",
    "vite": "^8.3.5",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "zod": "^4.6.7"
