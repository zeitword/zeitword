    "@better-auth/mcp": "^1.7.12",
    "@better-auth/oauth-provider": "^1.7.12",
    "@libsql/client": "^0.18.0",
    "@lucide/vue": "^1.61.0",
    "@modelcontextprotocol/server": "^2.3.1",
    "@nuxt/fonts": "^1.0.1",
    "@nuxt/image": "2.2.0",
