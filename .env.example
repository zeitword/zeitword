# DB (Default value for local postgres setup)
NUXT_DSN="postgresql://postgres:postgres@localhost:5432/postgres?sslmode=disable"
# Better Auth: generate a random secret of at least 32 characters.
NUXT_AUTH_SECRET=""
NUXT_PUBLIC_APP_URL="http://localhost:3000"
# Optional comma-separated socket IPs of trusted reverse proxies. Those proxies
# must overwrite X-Forwarded-For. Leave empty for direct local connections.
NUXT_AUTH_TRUSTED_PROXY_IPS=""

# AWS S3
NUXT_S3_ACCESS_KEY_ID="any"
NUXT_S3_SECRET_ACCESS_KEY="any"
NUXT_S3_ENDPOINT="http://localhost:8333"
NUXT_S3_BUCKET="zeitword"
NUXT_S3_REGION="eu-central-1"
## curl -X PUT http://localhost:8333/zeitword || true

# OpenAI (platform key for AI translation)
NUXT_OPENAI_API_KEY=""

# Waitlist
NUXT_RESEND=""
NUXT_PUBLIC_SITE_URL=""
